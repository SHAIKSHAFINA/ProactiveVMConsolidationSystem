# PatchXProCon Dashboard — Environment Configuration
# Copy this file to backend/.env and adjust only the settings you need.
# By default, simulator files are resolved from the workspace root's
# PatchTST-VM-Consolidation/ directory.

# ── Simulator (read-only, never modified) ──────────────────────────────────
# Set these only if your simulator is stored elsewhere:
# SIM_PROJECT_DIR=
# SIM_SAVED_RESULTS_DIR=
# SIM_INPUT_CSV=

# ── Dashboard storage (writable, inside dashboard project only) ────────────
DASHBOARD_RUNS_DIR=./runs
DASHBOARD_UPLOADS_DIR=./uploads

# ── Backend server ─────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Frontend dev server ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000

# ── Simulation execution ───────────────────────────────────────────────────
SIM_EXECUTION_ENABLED=true
SIM_TIMEOUT_SECONDS=3600
RAW_BITBRAINS_CSV=patch_models/bitbrains_raw_combined.csv
PATCHTST_CHECKPOINT=patch_models/PatchTST_best.pt
SCALER_PKL=patch_models/train_only_scaler.pkl
LR_CLASSIFIER_PKL=patch_models/adaptive_logistic_regression.joblib
LR_RISK_THRESHOLD=0.66
CLASSIFIER_SKLEARN_VERSION=1.6.1

# Model artifacts are not included in this repository. Leave the defaults
# if you provide them in <workspace-root>/patch_models/, or set local paths:
# PATCHTST_CHECKPOINT=
# SCALER_PKL=
# LR_CLASSIFIER_PKL=
